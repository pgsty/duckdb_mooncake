# name: test/sql/mooncake.test
# description: load the Mooncake scanner and validate its storage registration
# group: [sql]

statement ok
LOAD '{BUILD_DIRECTORY}/extension/mooncake/mooncake.duckdb_extension'

query I
SELECT count(*) FROM duckdb_extensions() WHERE extension_name = 'mooncake' AND loaded
----
1

statement error
ATTACH ':memory:' AS mirror (TYPE mooncake)
----
Missing required option URI

statement error
ATTACH ':memory:' AS mirror (TYPE mooncake, URI 'unused')
----
Missing required option DATABASE
